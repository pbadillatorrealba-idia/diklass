{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "incremental": true,
    "tsBuildInfoFile": "./.expo/tsconfig.tsbuildinfo",
    "allowImportingTsExtensions": true,
    "types": ["bun-types", "expo/types"],
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": ["**/*.ts", "**/*.tsx", ".expo/types/**/*.ts", "expo-env.d.ts", "nativewind-env.d.ts"],
  "exclude": [
    "node_modules",
    "dist",
    "maestro",
    "openspec",
    ".claude",
    ".agents",
    ".codex",
    ".github"
  ]
}
