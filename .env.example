EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
EXPO_PUBLIC_SUPABASE_ANON_KEY=replace-with-local-anon-key
EXPO_PUBLIC_APP_ENV=local

# Modo de escucha: `real` usa micrófono + transcripción real (Edge Function transcribe-audio, cuyo
# secreto OPENAI_API_KEY va en supabase/functions/.env, nunca aquí); vacío usa el guion simulado.
# EXPO_PUBLIC_VOZ_MODO=real
# Duración de la ventana de captura en ms (por defecto 30000).
# EXPO_PUBLIC_VOZ_VENTANA_MS=30000

# Solo para provisioning local/servidor; nunca usar como EXPO_PUBLIC_*.
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_SERVICE_ROLE_KEY=replace-with-local-service-role-key

# Solo para `bun scripts/cargar-corpus-conocimiento.ts`: veterinario sintético provisionado
# que incorpora el corpus de demostración (tests/fixtures/veterinarians.json).
CORPUS_VET_EMAIL=vet.ana@example.test
CORPUS_VET_PASSWORD=replace-with-synthetic-vet-password

# Instancia local desechable de testing, independiente de desarrollo (nunca usar .env como fallback).
# Las dos primeras variables son las únicas que se inyectan en la exportación web.
# TEST_SUPABASE_URL=http://127.0.0.1:55321
# TEST_SUPABASE_ANON_KEY=replace-with-test-anon-key
# TEST_DATABASE_URL=postgresql://postgres:replace-with-test-password@127.0.0.1:55322/postgres
# TEST_SUPABASE_PROJECT_ID=diklass-test-local
# Solo para tests de administración Auth/Storage; nunca EXPO_PUBLIC_*.
# TEST_SUPABASE_SERVICE_ROLE_KEY=replace-with-test-service-role-key
# Solicitar backend sin configuración completa falla antes de escribir.
# SUPABASE_LIVE_TESTS=1
# E2E_BACKEND=1
# E2E_WEB_PORT=8083
# PLAYWRIGHT_BASE_URL=http://127.0.0.1:8083

# El runner genera TEST_SCOPE_FILE, TEST_ACTORS_FILE, TEST_BACKEND, TEST_RUT_START,
# TEST_RUT_END y TEST_WEB_SERVER_READY; no apuntarlos a archivos/servidores ajenos.
# Activa solo la prueba del propio ciclo de vida, ejecutada fuera del runner (evita lock anidado):
# TEST_LIFECYCLE_TESTS=1
