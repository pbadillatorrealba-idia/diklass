EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
EXPO_PUBLIC_SUPABASE_ANON_KEY=replace-with-local-anon-key
EXPO_PUBLIC_APP_ENV=local

# Solo para provisioning local/servidor; nunca usar como EXPO_PUBLIC_*.
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_SERVICE_ROLE_KEY=replace-with-local-service-role-key

# Solo para `bun scripts/cargar-corpus-conocimiento.ts`: veterinario sintético provisionado
# que incorpora el corpus de demostración (tests/fixtures/veterinarians.json).
CORPUS_VET_EMAIL=vet.ana@example.test
CORPUS_VET_PASSWORD=replace-with-synthetic-vet-password
