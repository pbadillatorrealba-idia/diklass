{
  "expo": {
    "name": "Diklass",
    "slug": "diklass",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "diklass",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.diklass.app"
    },
    "android": {
      "package": "com.diklass.app"
    },
    "web": {
      "output": "static"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-status-bar",
      [
        "expo-font",
        {
          "android": {
            "fonts": [
              {
                "fontFamily": "Atkinson Hyperlegible Next",
                "fontDefinitions": [
                  {
                    "path": "./assets/fonts/AtkinsonHyperlegibleNext_400Regular.ttf",
                    "weight": 400
                  },
                  {
                    "path": "./assets/fonts/AtkinsonHyperlegibleNext_500Medium.ttf",
                    "weight": 500
                  },
                  {
                    "path": "./assets/fonts/AtkinsonHyperlegibleNext_600SemiBold.ttf",
                    "weight": 600
                  },
                  {
                    "path": "./assets/fonts/AtkinsonHyperlegibleNext_700Bold.ttf",
                    "weight": 700
                  }
                ]
              }
            ]
          },
          "ios": {
            "fonts": [
              "./assets/fonts/AtkinsonHyperlegibleNext_400Regular.ttf",
              "./assets/fonts/AtkinsonHyperlegibleNext_500Medium.ttf",
              "./assets/fonts/AtkinsonHyperlegibleNext_600SemiBold.ttf",
              "./assets/fonts/AtkinsonHyperlegibleNext_700Bold.ttf"
            ]
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "9b79c86f-0c0e-405e-a5e5-2a6b4741561f"
      }
    },
    "owner": "idia"
  }
}
