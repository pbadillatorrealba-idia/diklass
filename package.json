{
  "name": "diklass",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "start:web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "gate": "sh scripts/gate.sh",
    "format": "biome format --write .",
    "test": "bun test tests/unit tests/integration",
    "test:integration": "bun scripts/run-isolated-tests.ts integration",
    "test:e2e:web": "bun scripts/run-isolated-tests.ts web",
    "test:e2e:smoke": "bun scripts/run-isolated-tests.ts web login.spec.ts navegacion.spec.ts --project=chromium",
    "test:backend:start": "bun scripts/test-backend.ts start",
    "test:backend:stop": "bun scripts/test-backend.ts stop",
    "test:recover": "bun scripts/run-isolated-tests.ts recover",
    "db:start": "supabase start -x realtime,imgproxy,mailpit,postgres-meta,studio,logflare,vector,supavisor",
    "test:e2e:native": "maestro test tests/e2e/native",
    "provision:veterinarians": "bun scripts/provision-veterinarians.ts",
    "provision:demo": "bun scripts/provision-demo-data.ts",
    "demo:check": "bun scripts/demo/contratos-demo.ts && bun test tests/unit/scripts/datos-demo.test.ts tests/unit/scripts/contratos-demo.test.ts tests/unit/scripts/provision-demo.test.ts",
    "demo:reset": "bun scripts/reset-demo.ts",
    "db:types": "supabase gen types --lang=typescript --local > src/lib/supabase/database.types.ts"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.2",
    "@supabase/supabase-js": "^2.117.0",
    "@tanstack/react-form": "^1.33.5",
    "@tanstack/react-query": "^5.103.2",
    "expo": "~57.0.25",
    "expo-audio": "~57.0.5",
    "expo-constants": "~57.0.19",
    "expo-font": "~57.0.4",
    "expo-linking": "~57.0.11",
    "expo-router": "~57.0.23",
    "expo-secure-store": "~57.0.4",
    "expo-splash-screen": "~57.0.9",
    "expo-status-bar": "~57.0.1",
    "marked": "^18.1.2",
    "nativewind": "4.2.6",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-calendars": "^1.1314.0",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.2",
    "react-native-svg": "15.15.4",
    "react-native-web": "~0.21.2",
    "zod": "^4.6.7",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@biomejs/biome": "2.5.14",
    "@playwright/test": "1.63.0",
    "playwright-core": "1.63.0",
    "@types/react": "~19.2.18",
    "bun-types": "1.4.2",
    "tailwindcss": "^3.4.19",
    "typescript": "~6.0.3"
  }
}
