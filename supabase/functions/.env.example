# Secretos locales de las Edge Functions (copiar a supabase/functions/.env; ignorado por git).
# Los carga `supabase functions serve --env-file supabase/functions/.env`. Nunca como EXPO_PUBLIC_*.
OPENAI_API_KEY=replace-with-openai-api-key

# Voz del asistente (función `speak`); opcionales
# TTS_MODEL=gpt-4o-mini-tts
# TTS_VOICE=alloy
# Agente (función `agent`): proveedor:modelo y la clave del proveedor elegido
# AGENT_MODEL=openai:gpt-5.5
